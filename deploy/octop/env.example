# ============================================================
# Octop 场景环境变量（systemd EnvironmentFile，权限必须 600）
# 位置：/etc/universal-db-mcp/env
# 用法：cp env.example /etc/universal-db-mcp/env && chmod 600 ...
#      把 <---- 全部替换成实际值
# ============================================================

# --- 服务模式（本场景固定）---
MODE=http
HTTP_PORT=3000
HTTP_HOST=127.0.0.1

# --- 注册表与审计 ---
DATASOURCE_CONFIG=/etc/universal-db-mcp/registry.json
AUDIT_LOG_PATH=/var/log/universal-db-mcp/audit.ndjson
TRUST_AUDIT_USER_HEADER=false

# --- 限流与会话（按需调整）---
RATE_LIMIT_MAX=200
RATE_LIMIT_WINDOW=1m
SESSION_TIMEOUT=3600000
SESSION_CLEANUP_INTERVAL=300000

# --- 连接器 API keys（openssl rand -hex 32 生成）---
KEY_OCTOP_FIN=<---- 财务分析连接器 key
KEY_OCTOP_OPS=<---- 运维助手连接器 key
KEY_OCTOP_HR=<---- 人事查询连接器 key

# --- 数据源（只读账号）---
FIN_HOST=<---- 财务库地址        # 如 10.0.3.11
FIN_USER=<---- 财务只读账号
FIN_PWD=<---- 财务口令
FIN_DATABASE_ACTUAL=finance      # 备查：DB_DATABASE 来自注册表 database 字段

OPS_HOST=<---- 运维库地址
OPS_USER=<---- 运维只读账号
OPS_PWD=<---- 运维口令

HR_HOST=<---- 人事库地址
HR_USER=<---- 人事只读账号
HR_PWD=<---- 人事口令